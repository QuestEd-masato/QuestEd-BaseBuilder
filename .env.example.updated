# QuestEd 環境変数設定例 (更新版)
# 本番環境では必ずこれらの値を設定してください

# ========================================
# 基本設定
# ========================================

# Flask設定
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-super-secret-key-here-change-this-in-production-must-be-32-chars-long

# アプリケーション基本設定
APP_NAME=QuestEd
APP_VERSION=1.0.0
DEBUG=false  # 本番環境では必ずfalse

# ========================================
# データベース設定
# ========================================

# メインデータベース
DB_USERNAME=quested_user
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_NAME=quested

# 本番環境用（読み書き分離）
# PROD_DB_WRITE_HOST=your-write-db-host
# PROD_DB_READ_HOST=your-read-db-host

# テスト用データベース
TEST_DB_NAME=quested_test

# ========================================
# セキュリティ設定 (新規追加)
# ========================================

# 暗号化キー（機密データ暗号化用）
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# JWT設定
JWT_SECRET_KEY=your-jwt-secret-key-different-from-main-secret
JWT_EXPIRATION_HOURS=24

# パスワード設定
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false

# セッション設定
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=false  # 本番環境ではtrue
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# CSRF設定
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600

# ========================================
# レート制限設定 (新規追加)
# ========================================

# API レート制限
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_LOGIN=5 per minute
RATELIMIT_API=1000 per hour

# ログイン試行制限
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=300  # 5分

# ========================================
# AI機能設定
# ========================================

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# AI機能有効化フラグ
AI_FEATURES_ENABLED=true
AI_CHAT_ENABLED=true
AI_CURRICULUM_GENERATION_ENABLED=true

# ========================================
# バックグラウンド処理設定
# ========================================

# Celery設定
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Tokyo

# Redis設定
REDIS_URL=redis://localhost:6379/0

# ========================================
# メール設定 (新規追加)
# ========================================

# メール送信設定
MAIL_ENABLED=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=QuestEd System <noreply@yourdomain.com>

# 本番環境用メール設定
# PROD_MAIL_SERVER=your-mail-server
# PROD_MAIL_USERNAME=your-prod-mail-username
# PROD_MAIL_PASSWORD=your-prod-mail-password

# ========================================
# ファイルアップロード設定 (新規追加)
# ========================================

# ファイルアップロード
UPLOAD_FOLDER=static/uploads
SECURE_UPLOAD_FOLDER=uploads  # Webルート外
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt

# 本番環境用（S3）
# AWS_S3_BUCKET=your-s3-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ========================================
# ログ設定 (新規追加)
# ========================================

# ログレベル
LOG_LEVEL=INFO
LOG_FILE=logs/quested.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# セキュリティログ
SECURITY_LOG_ENABLED=true
SECURITY_LOG_FILE=logs/security.log

# アクセスログ
ACCESS_LOG_ENABLED=true
ACCESS_LOG_FILE=logs/access.log

# ========================================
# 監視・アラート設定 (新規追加)
# ========================================

# Sentry設定（エラー監視）
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0

# 監視設定
HEALTH_CHECK_ENABLED=true
PERFORMANCE_MONITORING=true

# ========================================
# CORS設定 (新規追加)
# ========================================

# CORS設定
CORS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
CORS_SUPPORTS_CREDENTIALS=true

# 本番環境用
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ========================================
# テスト設定 (新規追加)
# ========================================

# テスト環境設定
TESTING=false
TEST_DATABASE_URL=sqlite:///:memory:
SKIP_AUTH_IN_TESTS=false

# テスト用外部サービスモック
MOCK_OPENAI_API=false
MOCK_EMAIL_SENDING=false

# ========================================
# 機能フラグ (新規追加)
# ========================================

# 機能の有効/無効設定
VOICE_INPUT_ENABLED=false  # 一時的に無効化
BASEBUILDER_MODULE_ENABLED=true
ADMIN_PANEL_ENABLED=true
API_ENDPOINTS_ENABLED=true

# 実験的機能
EXPERIMENTAL_FEATURES_ENABLED=false
BETA_FEATURES_ENABLED=false

# ========================================
# パフォーマンス設定 (新規追加)
# ========================================

# データベース接続プール
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# キャッシュ設定
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300  # 5分

# 本番環境用キャッシュ
# CACHE_TYPE=redis
# CACHE_REDIS_URL=redis://localhost:6379/2

# ========================================
# 開発・デバッグ設定
# ========================================

# デバッグ設定
FLASK_DEBUG=true  # 開発環境のみ
WERKZEUG_DEBUG_PIN=off
TEMPLATES_AUTO_RELOAD=true

# プロファイリング
PROFILING_ENABLED=false
SQL_ECHO=false  # SQLクエリのログ出力

# ========================================
# 本番環境専用設定
# ========================================

# 本番環境でのみ使用
# FORCE_HTTPS=true
# HSTS_MAX_AGE=31536000
# CSP_ENABLED=true
# SECURE_HEADERS_ENABLED=true

# CDN設定
# CDN_DOMAIN=cdn.yourdomain.com
# STATIC_URL_PREFIX=https://cdn.yourdomain.com/static

# バックアップ設定
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # 毎日午前2時
# BACKUP_RETENTION_DAYS=30

# ========================================
# 注意事項
# ========================================

# 1. SECRET_KEY は必ず本番環境で変更してください
# 2. ENCRYPTION_KEY は機密データ暗号化に使用されるため、厳重に管理してください
# 3. 本番環境では環境変数またはAWS Secrets Managerを使用してください
# 4. パスワードやAPIキーは決してコードにハードコードしないでください
# 5. 本番環境では DEBUG=false, FLASK_DEBUG=false に設定してください
# QuestEd 最小限 .env テンプレート
# すぐに開始するための必須設定のみ

# ========================================
# 必須設定（必ず変更してください）
# ========================================

# Flask基本設定
SECRET_KEY=change-this-to-a-random-32-character-string-for-production
FLASK_ENV=development
FLASK_DEBUG=true

# データベース接続
DB_USERNAME=quested_user
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_NAME=quested

# セキュリティ
ENCRYPTION_KEY=change-this-to-a-32-char-encryption-key

# ========================================
# 推奨設定（開発環境でも設定推奨）
# ========================================

# OpenAI API（AI機能を使用する場合）
OPENAI_API_KEY=your-openai-api-key-here

# Redis（推奨 - パフォーマンス向上）
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# メール送信（ユーザー登録・パスワードリセット用）
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ========================================
# オプション設定（必要に応じて）
# ========================================

# レート制限（Redisが利用可能な場合）
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# ログレベル
LOG_LEVEL=INFO

# ファイルアップロード
MAX_CONTENT_LENGTH=16777216  # 16MB

# 機能フラグ
VOICE_INPUT_ENABLED=false  # セキュリティ上一時無効化
AI_FEATURES_ENABLED=true
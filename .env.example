# QuestEd 環境変数設定ファイル
# このファイルを .env にコピーして、実際の値を設定してください

# ====================
# Flask設定
# ====================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-this-in-production

# ====================
# データベース設定
# ====================
# MySQL接続情報
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=quested
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# SQLAlchemy設定
SQLALCHEMY_DATABASE_URI=mysql+pymysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?charset=utf8mb4
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ====================
# OpenAI API設定
# ====================
OPENAI_API_KEY=your-openai-api-key-here

# ====================
# メール設定
# ====================
# For Gmail, you need to:
# 1. Enable 2-factor authentication in your Google account
# 2. Generate an app-specific password at https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below (not your regular Gmail password)

# SMTP Configuration for EmailSender class
EMAIL_METHOD=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Flask-Mail Configuration (legacy compatibility)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=noreply@quested.example.com

# Test email recipient (for testing)
TEST_EMAIL=test-recipient@example.com

# ====================
# セキュリティ設定
# ====================
# セッション設定
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF設定
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=None

# MFA暗号化キー（Fernetキー）
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=your-fernet-key-here

# データ暗号化キー（機密データ保護用）
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-encryption-key-here

# ====================
# アプリケーション設定
# ====================
# アップロードファイル設定
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,csv

# ページネーション
ITEMS_PER_PAGE=20

# ====================
# Redis設定（オプション）
# ====================
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis
CACHE_REDIS_URL=${REDIS_URL}
CACHE_DEFAULT_TIMEOUT=300

# ====================
# Celery設定（オプション）
# ====================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ====================
# レート制限設定
# ====================
RATELIMIT_STORAGE_URL=${REDIS_URL}
RATELIMIT_DEFAULT="100 per hour"
RATELIMIT_HEADERS_ENABLED=True

# ====================
# ログ設定
# ====================
LOG_LEVEL=INFO
LOG_FILE=logs/quested.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ====================
# 開発環境設定
# ====================
# デバッグモード（本番環境では必ずFalseに）
DEBUG=True

# SQLデバッグ（開発時のみ）
SQLALCHEMY_ECHO=False

# ====================
# 本番環境設定
# ====================
# 本番環境のURL
PRODUCTION_URL=https://quested.example.com

# SSL証明書パス（本番環境）
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ====================
# その他の設定
# ====================
# タイムゾーン
TIMEZONE=Asia/Tokyo

# 言語設定
DEFAULT_LANGUAGE=ja

# AIモデル設定
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7